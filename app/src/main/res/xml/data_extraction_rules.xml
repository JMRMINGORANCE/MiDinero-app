<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: la copia de Google y la transferencia a un móvil nuevo incluyen la base de datos y los ajustes. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <!-- Las fotos de tickets pasan al móvil nuevo; en la nube no, por el límite de espacio. -->
        <include domain="file" path="receipts/" />
    </device-transfer>
</data-extraction-rules>
